<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AI Pixel Art Color by Number</title>
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body>
  <h1>AI Pixel Art Color by Number</h1>
  <p>Capture your photo, and Gemma will curate a palette for your pixel art puzzle!</p>

  <div class="controls">
    <button id="capture">Capture image</button>
    <button id="clear">Reset Game</button>
  </div>

  <p id="status">Allow webcam access, then capture an image.</p>

  <div id="preview-container">
    <video id="webcam" autoplay playsinline></video>
    <canvas id="snapshot" style="display: none; width: 100%; max-width: 400px; border: 4px solid #333; border-radius: 8px;"></canvas>
  </div>

  <div id="game-container">
    <div id="theme-display" style="font-style: italic; margin-bottom: 10px; font-weight: 500;"></div>
    <div id="palette"></div>
    <canvas id="game-canvas"></canvas>
  </div>

  <script>
    const video = document.querySelector("#webcam");
    const status = document.querySelector("#status");
    const previewContainer = document.querySelector("#preview-container");
    const gameContainer = document.querySelector("#game-container");
    const paletteContainer = document.querySelector("#palette");
    const themeDisplay = document.querySelector("#theme-display");
    const gameCanvas = document.querySelector("#game-canvas");
    const gCtx = gameCanvas.getContext("2d");

    let currentPalette = [];
    let selectedColorIndex = null;
    let gameData = null;
    let isPainting = false;
    let filledGrid = [];

    const GRID_SIZE = 64;
    const PIXEL_SIZE = 8;

    async function setupWebcam() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: true });
        video.srcObject = stream;
      } catch {
        status.textContent = "Webcam access was denied or is unavailable.";
      }
    }

    function hexToRgb(hex) {
      const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      return result ? {
        r: parseInt(result[1], 16),
        g: parseInt(result[2], 16),
        b: parseInt(result[3], 16)
      } : null;
    }

    function getColorDistance(rgb1, rgb2) {
      return Math.sqrt(
        Math.pow(rgb1.r - rgb2.r, 2) +
        Math.pow(rgb1.g - rgb2.g, 2) +
        Math.pow(rgb1.b - rgb2.b, 2)
      );
    }

    function generateLocalGrid(sourceCanvas) {
      const grid = [];
      const canvas = document.createElement("canvas");
      canvas.width = GRID_SIZE;
      canvas.height = GRID_SIZE;
      const ctx = canvas.getContext("2d");

      ctx.drawImage(sourceCanvas, 0, 0, GRID_SIZE, GRID_SIZE);
      const imageData = ctx.getImageData(0, 0, GRID_SIZE, GRID_SIZE).data;
      const paletteRgb = currentPalette.map(hex => hexToRgb(hex));

      for (let y = 0; y < GRID_SIZE; y++) {
        const row = [];
        for (let x = 0; x < GRID_SIZE; x++) {
          const idx = (y * GRID_SIZE + x) * 4;
          const pixelRgb = { r: imageData[idx], g: imageData[idx+1], b: imageData[idx+2] };
          let minDistance = Infinity;
          let closestIndex = 0;
          paletteRgb.forEach((paletteRgbColor, pIdx) => {
            if (!paletteRgbColor) return;
            const dist = getColorDistance(pixelRgb, paletteRgbColor);
            if (dist < minDistance) {
              minDistance = dist;
              closestIndex = pIdx;
            }
          });
          row.push(closestIndex);
        }
        grid.push(row);
      }
      return grid;
    }

    async function captureAndProcess() {
      if (!video.videoWidth) {
        status.textContent = "The webcam is not ready yet.";
        return;
      }

      const captureBtn = document.querySelector("#capture");
      captureBtn.disabled = true;

      const snapshot = document.querySelector("#snapshot");
      snapshot.width = video.videoWidth;
      snapshot.height = video.videoHeight;
      const sCtx = snapshot.getContext("2d");
      sCtx.drawImage(video, 0, 0);

      snapshot.style.display = "block";
      video.style.display = "none";

      if (video.srcObject) {
        video.srcObject.getTracks().forEach(track => track.stop());
      }

      status.className = "";
      status.innerHTML = `<div class="loader"></div> Gemma is curating your palette...`;

      const tempCanvas = document.createElement("canvas");
      const scale = Math.min(1, 128 / video.videoWidth);
      tempCanvas.width = Math.max(1, Math.round(video.videoWidth * scale));
      tempCanvas.height = Math.max(1, Math.round(video.videoHeight * scale));
      const ctx = tempCanvas.getContext("2d");
      ctx.drawImage(video, 0, 0);
      const imageDataUrl = tempCanvas.toDataURL("image/png");

      try {
        const response = await fetch("/api/analyze", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ image: imageDataUrl })
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.detail || errorData.message || `Server Error: ${response.status}`);
        }

        const data = await response.json();
        gameData = data.result;
        if (!gameData || gameData.error) {
          throw new Error(gameData?.error || "Gemma failed to generate the palette.");
        }

        currentPalette = gameData.palette || [];
        const grid = generateLocalGrid(snapshot);
        gameData.grid = grid;

        previewContainer.style.display = "none";
        initGame();

      } catch (error) {
        console.error("Capture Error:", error);
        status.textContent = `Error: ${error.message}`;
        captureBtn.disabled = false;
        snapshot.style.display = "none";
        video.style.display = "block";
        setupWebcam();
      }
    }

    function initGame() {
      if (currentPalette.length === 0) {
        status.textContent = "Error: No palette received from AI.";
        return;
      }
      themeDisplay.textContent = gameData.theme || "";
      status.className = "success";
      status.textContent = "Color the pixels by their numbers!";
      gameContainer.style.display = "flex";

      gameCanvas.width = GRID_SIZE * PIXEL_SIZE;
      gameCanvas.height = GRID_SIZE * PIXEL_SIZE;
      filledGrid = Array.from({ length: GRID_SIZE }, () => Array(GRID_SIZE).fill(false));

      paletteContainer.innerHTML = "";
      currentPalette.forEach((color, index) => {
        const swatch = document.createElement("div");
        swatch.className = "color-swatch";
        swatch.style.backgroundColor = color;
        swatch.textContent = index;
        swatch.onclick = () => selectColor(index.toString(), swatch);
        paletteContainer.appendChild(swatch);
      });
      drawGame();
    }

    function drawGame() {
      gCtx.clearRect(0, 0, gameCanvas.width, gameCanvas.height);
      for (let y = 0; y < GRID_SIZE; y++) {
        for (let x = 0; x < GRID_SIZE; x++) {
          const colorIndex = gameData.grid[y][x];
          if (filledGrid[y][x]) {
            gCtx.fillStyle = currentPalette[colorIndex];
            gCtx.fillRect(x * PIXEL_SIZE, y * PIXEL_SIZE, PIXEL_SIZE, PIXEL_SIZE);
          } else {
            gCtx.fillStyle = "white";
            gCtx.fillRect(x * PIXEL_SIZE, y * PIXEL_SIZE, PIXEL_SIZE, PIXEL_SIZE);
            gCtx.fillStyle = "#ddd";
            gCtx.font = "5px Arial";
            gCtx.textAlign = "center";
            gCtx.textBaseline = "middle";
            gCtx.fillText(colorIndex, x * PIXEL_SIZE + PIXEL_SIZE/2, y * PIXEL_SIZE + PIXEL_SIZE/2);
          }
        }
      }
    }

    function handleInput(e) {
      if (selectedColorIndex === null) {
        status.textContent = "Please select a color from the palette first!";
        return;
      }
      const rect = gameCanvas.getBoundingClientRect();
      const x = Math.floor((e.clientX - rect.left) / (rect.width / GRID_SIZE));
      const y = Math.floor((e.clientY - rect.top) / (rect.height / GRID_SIZE));

      if (x >= 0 && x < GRID_SIZE && y >= 0 && y < GRID_SIZE) {
        const targetColor = gameData.grid[y][x];
        if (targetColor === selectedColorIndex) {
          filledGrid[y][x] = true;
          status.textContent = "Correct!";
          drawGame();
          checkWin();
        } else {
          status.textContent = "Wrong color! Try again.";
        }
      }
    }

    gameCanvas.onmousedown = (e) => {
      isPainting = true;
      handleInput(e);
    };
    gameCanvas.onmousemove = (e) => {
      if (isPainting) handleInput(e);
    };
    window.onmouseup = () => {
      isPainting = false;
    };

    window.addEventListener("keydown", (event) => {
      const key = event.key;
      if (key >= '0' && key <= '9') {
        const index = parseInt(key);
        if (index < currentPalette.length) {
          const swatches = document.querySelectorAll(".color-swatch");
          if (swatches[index]) {
            selectColor(index.toString(), swatches[index]);
          }
        }
      }
    });

    function selectColor(index, element) {
      selectedColorIndex = index;
      document.querySelectorAll(".color-swatch").forEach(s => s.classList.remove("active"));
      element.classList.add("active");
    }

    function checkWin() {
      const total = GRID_SIZE * GRID_SIZE;
      const filled = filledGrid.flat().filter(Boolean).length;
      if (filled === total) {
        status.className = "success";
        status.textContent = "🎉 Masterpiece complete! You've finished the painting!";
      }
    }

    document.querySelector("#capture").addEventListener("click", captureAndProcess);
    document.querySelector("#clear").addEventListener("click", () => {
      gameContainer.style.display = "none";
      previewContainer.style.display = "block";
      document.querySelector("#snapshot").style.display = "none";
      video.style.display = "block";
      status.className = "";
      status.textContent = "Allow webcam access, then capture an image.";
      document.querySelector("#capture").disabled = false;
      setupWebcam();
    });

    setupWebcam();
  </script>
</body>
</html>
